.page {
  min-height: 100vh;
  background-color: #F5F7FA;
}

.header {
  background: linear-gradient(135deg, #1E5EFA 0%, #4080FF 100%);
  padding-top: env(safe-area-inset-top);
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.verify-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background-color: rgba(255, 255, 255, 0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
}

.verify-icon {
  font-size: 28rpx;
}

.verify-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.tabs {
  display: flex;
  padding: 0 32rpx 16rpx;
  gap: 24rpx;
}

.tab {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  padding: 12rpx 8rpx;
  position: relative;
  font-weight: 500;
}

.tab.active {
  color: #FFFFFF;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background-color: #FFFFFF;
  border-radius: 2rpx;
}

.container {
  margin-top: 24rpx;
  padding: 0 32rpx;
}

.cert-card {
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.cert-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.cert-number {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cert-icon {
  font-size: 32rpx;
}

.cert-number-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

.cert-info {
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  margin-bottom: 8rpx;
  line-height: 1.6;
}

.info-label {
  font-size: 26rpx;
  color: #86909C;
  flex-shrink: 0;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #4E5969;
  flex: 1;
  min-width: 0;
}

.cert-liability {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.liability-label {
  font-size: 26rpx;
  color: #1E5EFA;
  font-weight: 500;
}

.liability-text {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.6;
}

.cert-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F2F3F5;
}

.cert-date {
  font-size: 24rpx;
  color: #86909C;
}

.cert-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 8rpx 24rpx;
  border-radius: 32rpx;
  background-color: #F2F3F5;
}

.action-btn text {
  font-size: 24rpx;
  color: #4E5969;
}

.action-btn.primary {
  background: linear-gradient(135deg, #1E5EFA 0%, #4080FF 100%);
}

.action-btn.primary text {
  color: #FFFFFF;
}

.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #F2F3F5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.modal-close {
  font-size: 40rpx;
  color: #86909C;
  line-height: 1;
}

.modal-body {
  padding: 32rpx;
}

.verify-desc {
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 24rpx;
  display: block;
}

.verify-result {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.verify-result.success {
  background-color: #E8FFEA;
}

.verify-result.error {
  background-color: #FFECE8;
}

.result-icon {
  font-size: 32rpx;
  font-weight: bold;
}

.verify-result.success .result-icon {
  color: #00B42A;
}

.verify-result.error .result-icon {
  color: #F53F3F;
}

.result-text {
  font-size: 26rpx;
  color: #4E5969;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: #86909C;
  margin-top: 16rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.5;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #86909C;
}
