.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 160rpx;
}

.status-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 30rpx;
  margin: 20rpx;
  border-radius: 16rpx;
}

.status-bar.status-completed {
  background: linear-gradient(135deg, #00B42A 0%, #3CB371 100%);
}

.status-bar.status-processing {
  background: linear-gradient(135deg, #1E5EFA 0%, #4A80FF 100%);
}

.status-bar.status-pending {
  background: linear-gradient(135deg, #FF7D00 0%, #FF9A2E 100%);
}

.status-bar.status-cancelled {
  background: linear-gradient(135deg, #86909C 0%, #C9CDD4 100%);
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #fff;
  margin-right: 12rpx;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.status-text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}

.accident-number {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.section {
  margin: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #1E5EFA;
}

.info-card {
  background: #F7F8FA;
  border-radius: 12rpx;
  overflow: hidden;
}

.info-row {
  display: flex;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #EBEDF0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row.desc-row {
  flex-direction: column;
}

.info-row.desc-row .info-label {
  margin-bottom: 12rpx;
}

.info-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #86909C;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  font-size: 26rpx;
  color: #1D2129;
  word-break: break-all;
}

.info-value.location {
  line-height: 1.6;
}

.vehicle-card {
  background: #F7F8FA;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.vehicle-card:last-child {
  margin-bottom: 0;
}

.vehicle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #1E5EFA 0%, #4A80FF 100%);
}

.plate-box {
  display: flex;
  align-items: center;
}

.plate-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  margin-right: 16rpx;
}

.plate-color {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
}

.vehicle-type {
  color: rgba(255, 255, 255, 0.9);
  font-size: 24rpx;
}

.vehicle-info .info-row {
  padding: 16rpx 24rpx;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.photo-item {
  position: relative;
  width: calc((100% - 24rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-item image {
  width: 100%;
  height: 100%;
}

.photo-item:active {
  opacity: 0.8;
}

.photo-type {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  padding: 4rpx 12rpx;
  background: rgba(30, 94, 250, 0.9);
  color: #fff;
  font-size: 20rpx;
  border-radius: 8rpx;
}

.liability-card {
  background: linear-gradient(135deg, #FFF7E6 0%, #FFEFD6 100%);
  border-radius: 12rpx;
  padding: 30rpx;
  border: 2rpx solid #FFD591;
}

.liability-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.liability-icon {
  font-size: 40rpx;
  margin-right: 12rpx;
}

.liability-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #8A4B00;
}

.liability-parties {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.party-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
}

.party-item.primary {
  border: 2rpx solid #F53F3F;
}

.party-item.secondary {
  border: 2rpx solid #00B42A;
}

.party-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 8rpx;
}

.party-ratio {
  font-size: 24rpx;
  color: #86909C;
}

.party-item.primary .party-ratio {
  color: #F53F3F;
  font-weight: 600;
}

.party-item.secondary .party-ratio {
  color: #00B42A;
  font-weight: 600;
}

.party-vs {
  padding: 0 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #86909C;
}

.liability-desc {
  font-size: 26rpx;
  color: #8A4B00;
  line-height: 1.6;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 8rpx;
  margin-bottom: 16rpx;
}

.liability-time {
  font-size: 24rpx;
  color: #86909C;
  text-align: right;
}

.timeline {
  position: relative;
  padding-left: 40rpx;
}

.timeline-item {
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-dot {
  position: absolute;
  left: -40rpx;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: #C9CDD4;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx #C9CDD4;
  z-index: 1;
}

.timeline-dot.done {
  background: #00B42A;
  box-shadow: 0 0 0 2rpx #00B42A;
}

.timeline-line {
  position: absolute;
  left: -30rpx;
  top: 36rpx;
  width: 4rpx;
  height: calc(100% - 24rpx);
  background: #EBEDF0;
}

.timeline-content {
  background: #F7F8FA;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
}

.timeline-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 8rpx;
}

.timeline-desc {
  font-size: 24rpx;
  color: #4E5969;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.timeline-time {
  font-size: 22rpx;
  color: #86909C;
}

.cert-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #E8F3FF 0%, #D4E8FF 100%);
  border-radius: 16rpx;
  border: 2rpx solid #91C5FF;
}

.cert-card:active {
  opacity: 0.8;
}

.cert-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.cert-info {
  flex: 1;
}

.cert-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1E5EFA;
  margin-bottom: 8rpx;
}

.cert-number {
  font-size: 24rpx;
  color: #4E5969;
}

.cert-arrow {
  font-size: 36rpx;
  color: #1E5EFA;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #1E5EFA 0%, #4A80FF 100%);
  color: #fff;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-secondary {
  background: #F2F3F5;
  color: #1D2129;
}

.btn-secondary:active {
  background: #E5E6EB;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #86909C;
  font-size: 26rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #EBEDF0;
  border-top-color: #1E5EFA;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
