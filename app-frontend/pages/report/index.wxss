.page {
  min-height: 100vh;
  background-color: #F5F7FA;
}

.steps {
  background-color: #FFFFFF;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 4rpx solid #E5E6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #86909C;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.step-active .step-circle {
  background: linear-gradient(135deg, #1E5EFA 0%, #4080FF 100%);
  border-color: #1E5EFA;
  color: #FFFFFF;
}

.step-completed .step-circle {
  background-color: #00B42A;
  border-color: #00B42A;
  color: #FFFFFF;
}

.step-text {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
}

.step-active .step-text,
.step-completed .step-text {
  color: #1E5EFA;
  font-weight: 500;
}

.container {
  padding: 24rpx 32rpx;
}

.step-content {
  min-height: 400rpx;
}

.step-title {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.step-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.step-title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
}

.step-desc {
  font-size: 26rpx;
  color: #86909C;
  margin-bottom: 32rpx;
  display: block;
  line-height: 1.6;
}

.vehicle-section {
  margin-bottom: 24rpx;
}

.vehicle-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.vehicle-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D2129;
}

.vehicle-edit {
  font-size: 26rpx;
  color: #1E5EFA;
}

.plate-result {
  background-color: #F7F8FA;
  border: 2rpx dashed #C9CDD4;
  border-radius: 16rpx;
  padding: 32rpx;
  transition: all 0.2s ease;
}

.plate-result:active {
  background-color: #F0F5FF;
  border-color: #1E5EFA;
}

.plate-info {
  text-align: center;
}

.plate-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #1D2129;
  letter-spacing: 4rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, #F2F3F5 100%);
  border: 2rpx solid #1E5EFA;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  display: inline-block;
  margin-bottom: 16rpx;
}

.plate-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
}

.plate-color {
  padding: 6rpx 16rpx;
  font-size: 24rpx;
}

.plate-confidence {
  font-size: 24rpx;
  color: #86909C;
}

.plate-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
}

.placeholder-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.placeholder-text {
  font-size: 28rpx;
  color: #86909C;
}

.edit-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.edit-content {
  width: 600rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 40rpx;
}

.edit-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D2129;
  text-align: center;
  margin-bottom: 32rpx;
}

.edit-buttons {
  margin-top: 32rpx;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-input::after {
  content: '›';
  font-size: 32rpx;
  color: #86909C;
}

.photo-tips {
  background-color: #FFF7E8;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.tip-item {
  display: block;
  font-size: 26rpx;
  color: #FF7D00;
  line-height: 2;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: 210rpx;
  height: 210rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.photo-add {
  width: 210rpx;
  height: 210rpx;
  background-color: #F7F8FA;
  border: 2rpx dashed #C9CDD4;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 64rpx;
  color: #C9CDD4;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 8rpx;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.datetime-row {
  display: flex;
  gap: 16rpx;
}

.datetime-input {
  flex: 1;
}

.location-input {
  display: flex;
  gap: 16rpx;
}

.location-btn {
  width: 88rpx;
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.form-error {
  font-size: 24rpx;
  color: #F53F3F;
  margin-top: 8rpx;
  display: block;
}

.phone-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.wechat-phone-btn {
  flex-shrink: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  background: linear-gradient(135deg, #07C160 0%, #06AD56 100%);
  color: #FFFFFF;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.wechat-phone-btn::after {
  border: none;
}

.collision-section {
  display: flex;
  gap: 32rpx;
  justify-content: space-between;
}

.collision-vehicle {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.collision-vehicle-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #4E5969;
  margin-bottom: 16rpx;
}

.collision-diagram {
  width: 100%;
}

.car-sketch {
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid #E5E6EB;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #F7F8FA;
}

.car-part {
  width: 100%;
  padding: 16rpx 0;
  text-align: center;
  transition: all 0.2s ease;
  cursor: pointer;
}

.car-front {
  border-bottom: 2rpx dashed #E5E6EB;
}

.car-rear {
  border-top: 2rpx dashed #E5E6EB;
}

.car-part-active {
  background-color: #FFECE8;
}

.car-part-active .car-part-label {
  color: #F53F3F;
  font-weight: 600;
}

.car-part-label {
  font-size: 24rpx;
  color: #86909C;
}

.car-middle {
  display: flex;
  width: 100%;
  border-bottom: none;
}

.car-side {
  flex: 1;
  padding: 20rpx 0;
  text-align: center;
  transition: all 0.2s ease;
}

.car-left {
  border-right: 2rpx dashed #E5E6EB;
}

.car-right {
  border-left: 2rpx dashed #E5E6EB;
}

.car-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #86909C;
  font-weight: 500;
  padding: 20rpx 0;
}

.integrity-card {
  border: 2rpx solid #1E5EFA;
  background-color: #F0F5FF;
}

.integrity-header {
  margin-bottom: 16rpx;
}

.integrity-checkbox-label {
  display: flex;
  align-items: center;
}

.integrity-checkbox-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1E5EFA;
  margin-left: 12rpx;
}

.integrity-body {
  padding-left: 4rpx;
}

.integrity-text {
  font-size: 26rpx;
  color: #4E5969;
  line-height: 1.8;
}

.draft-info {
  text-align: center;
  margin-top: 12rpx;
}

.draft-text {
  font-size: 22rpx;
  color: #86909C;
}

.summary-section {
  margin-bottom: 16rpx;
}

.summary-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}

.summary-row {
  display: flex;
  margin-bottom: 12rpx;
  line-height: 1.6;
}

.summary-label {
  font-size: 26rpx;
  color: #86909C;
  flex-shrink: 0;
  width: 140rpx;
}

.summary-value {
  font-size: 26rpx;
  color: #4E5969;
  flex: 1;
}

.photo-preview {
  white-space: nowrap;
}

.preview-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: inline-block;
}

.notice-card {
  display: flex;
  align-items: flex-start;
  background-color: #FFF7E8;
  border: 2rpx solid #FFE7BA;
}

.notice-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.notice-content {
  flex: 1;
}

.notice-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF7D00;
  display: block;
  margin-bottom: 8rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.6;
}

.success-content {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.success-card {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 64rpx 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.08);
}

.success-icon {
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, #00B42A 0%, #0FC6C2 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 64rpx;
  font-weight: bold;
  margin: 0 auto 32rpx;
}

.success-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D2129;
  display: block;
  margin-bottom: 12rpx;
}

.success-desc {
  font-size: 28rpx;
  color: #86909C;
  display: block;
  margin-bottom: 48rpx;
}

.result-section {
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 48rpx;
  text-align: left;
}

.result-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E5E6EB;
}

.result-item:last-child {
  border-bottom: none;
}

.result-label {
  font-size: 26rpx;
  color: #86909C;
}

.result-value {
  font-size: 26rpx;
  color: #1D2129;
  font-weight: 500;
}

.success-buttons {
  margin-top: 32rpx;
}

.footer-buttons {
  display: flex;
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

.mr-16 {
  margin-right: 16rpx;
}

.mt-16 {
  margin-top: 16rpx;
}

.network-warning {
  display: flex;
  align-items: center;
  background: linear-gradient(90deg, #FFF7E6 0%, #FFE9CC 100%);
  padding: 20rpx 32rpx;
  border-bottom: 1rpx solid #FFD480;
}

.warning-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.warning-text {
  flex: 1;
  font-size: 24rpx;
  color: #FF7D00;
  line-height: 1.5;
}

.upload-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.upload-modal {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx;
  margin: 32rpx;
}

.upload-header {
  text-align: center;
  margin-bottom: 40rpx;
}

.upload-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 16rpx;
}

.upload-subtitle {
  display: block;
  font-size: 26rpx;
  color: #86909C;
  line-height: 1.5;
}

.upload-progress-section {
  margin-bottom: 32rpx;
}

.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.progress-label {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
}

.progress-value {
  font-size: 28rpx;
  color: #1E5EFA;
  font-weight: 600;
}

.progress-bar {
  width: 100%;
  height: 16rpx;
  background: #F2F3F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #1E5EFA 0%, #4080FF 100%);
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.photo-progress-list {
  max-height: 300rpx;
  overflow-y: auto;
  margin-bottom: 32rpx;
}

.photo-progress-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F2F3F5;
}

.photo-progress-item:last-child {
  border-bottom: none;
}

.photo-index {
  width: 120rpx;
  font-size: 24rpx;
  color: #4E5969;
}

.photo-progress-bar {
  flex: 1;
  height: 12rpx;
  background: #F2F3F5;
  border-radius: 6rpx;
  margin: 0 16rpx;
  overflow: hidden;
}

.photo-progress-fill {
  height: 100%;
  background: #00B42A;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.photo-progress-text {
  width: 80rpx;
  font-size: 24rpx;
  color: #00B42A;
  text-align: right;
}

.upload-tips {
  background: #F2F3F5;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.tip-text {
  display: block;
  font-size: 24rpx;
  color: #86909C;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.tip-text:last-child {
  margin-bottom: 0;
}

.upload-error {
  background: #FFECE8;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  border: 1rpx solid #FFC9C2;
}

.error-text {
  font-size: 26rpx;
  color: #F53F3F;
  line-height: 1.5;
}

.lane-switch-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 0;
}

.lane-switch-label {
  font-size: 28rpx;
  color: #4E5969;
}

.dashcam-upload-area {
  background-color: #F7F8FA;
  border: 2rpx dashed #C9CDD4;
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  text-align: center;
  transition: all 0.2s ease;
}

.dashcam-upload-area:active {
  background-color: #F0F5FF;
  border-color: #1E5EFA;
}

.dashcam-uploaded {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dashcam-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dashcam-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.dashcam-text {
  font-size: 28rpx;
  color: #4E5969;
  margin-bottom: 8rpx;
}

.dashcam-hint {
  font-size: 24rpx;
  color: #86909C;
}
