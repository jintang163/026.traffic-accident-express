.page {
  min-height: 100vh;
  background-color: #F5F7FA;
}

.header {
  background: linear-gradient(135deg, #1E5EFA 0%, #4080FF 100%);
  padding-bottom: 48rpx;
}

.header-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx;
}

.greeting-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
  margin-bottom: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  display: block;
}

.emergency-btns {
  display: flex;
  gap: 16rpx;
}

.emergency-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
  backdrop-filter: blur(10px);
}

.emergency-btn.police {
  background: rgba(245, 63, 63, 0.3);
}

.emergency-btn.insurance {
  background: rgba(0, 180, 42, 0.3);
}

.emergency-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.emergency-text {
  font-size: 22rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.container {
  margin-top: -32rpx;
  padding: 0 32rpx;
}

.quick-action {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #E8F3FF 0%, #F0F5FF 100%);
  border: 2rpx solid #D6E4FF;
}

.quick-action-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.quick-action-content {
  flex: 1;
}

.quick-action-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E5EFA;
  display: block;
  margin-bottom: 8rpx;
}

.quick-action-desc {
  font-size: 24rpx;
  color: #4E5969;
}

.arrow {
  font-size: 40rpx;
  color: #86909C;
  font-weight: bold;
}

.statistics {
  padding: 32rpx;
}

.stats-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.stats-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.stats-link {
  font-size: 24rpx;
  color: #1E5EFA;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.stats-number {
  font-size: 48rpx;
  font-weight: 700;
  color: #1E5EFA;
  line-height: 1.2;
}

.stats-label {
  font-size: 24rpx;
  color: #86909C;
  margin-top: 8rpx;
}

.stats-divider {
  width: 1rpx;
  height: 60rpx;
  background-color: #E5E6EB;
}

.quick-functions {
  margin-bottom: 32rpx;
}

.func-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
  margin-bottom: 24rpx;
}

.func-grid {
  display: flex;
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx 0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.func-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.func-icon {
  width: 88rpx;
  height: 88rpx;
  background: linear-gradient(135deg, #E8F3FF 0%, #D6E4FF 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.func-text {
  font-size: 24rpx;
  color: #4E5969;
  font-weight: 500;
}

.recent-section {
  margin-top: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D2129;
}

.section-more {
  font-size: 24rpx;
  color: #86909C;
}

.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  background-color: #FFFFFF;
  border-radius: 16rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #86909C;
  margin-top: 16rpx;
}

.accident-item {
  padding: 24rpx;
}

.accident-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.accident-number {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D2129;
}

.accident-info {
  gap: 12rpx;
}

.info-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #86909C;
  flex-shrink: 0;
  width: 140rpx;
}

.info-value {
  font-size: 26rpx;
  color: #4E5969;
  flex: 1;
  min-width: 0;
}
