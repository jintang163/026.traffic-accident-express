.verify-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 40rpx 32rpx;
}

.verify-header {
  text-align: center;
  padding: 40rpx 0;
}

.verify-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.verify-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.verify-desc {
  font-size: 26rpx;
  color: #999;
}

.verify-form {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #e5e5e5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}

.verify-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #1e5efa 0%, #3b7dff 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 16rpx;
  border: none;
}

.verify-result {
  margin-bottom: 24rpx;
}

.result-card {
  text-align: center;
  padding: 48rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.result-success {
  background: #f6ffed;
  border: 2rpx solid #b7eb8f;
}

.result-fail {
  background: #fff2f0;
  border: 2rpx solid #ffccc7;
}

.result-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.result-status {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.result-success .result-status {
  color: #52c41a;
}

.result-fail .result-status {
  color: #ff4d4f;
}

.result-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.result-info {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
}

.info-item {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.info-label {
  font-size: 26rpx;
  color: #999;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 500;
}

.verify-tips {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}
