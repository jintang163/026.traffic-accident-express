.container {
  min-height: 100vh;
  background-color: #F5F7FA;
  padding-bottom: 40rpx;
}

.header {
  background: linear-gradient(135deg, #1E5EFA 0%, #4A80FF 100%);
  padding: 40rpx 30rpx 60rpx;
  color: #fff;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar image {
  width: 100%;
  height: 100%;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn, .logout-btn {
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.25);
  border-radius: 40rpx;
  font-size: 26rpx;
  flex-shrink: 0;
}

.login-btn:active, .logout-btn:active {
  background: rgba(255, 255, 255, 0.35);
}

.stats-row {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding: 30rpx 0;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 16rpx;
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.menu-container {
  margin-top: -30rpx;
  padding: 0 20rpx;
}

.menu-group {
  background: #fff;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx 0;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.group-title {
  font-size: 26rpx;
  color: #86909C;
  padding: 10rpx 30rpx 20rpx;
  font-weight: 500;
}

.menu-list {
  border-top: 1rpx solid #F0F2F5;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F2F5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #F5F7FA;
}

.menu-icon {
  width: 60rpx;
  height: 60rpx;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1D2129;
}

.menu-badge {
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  background: #F53F3F;
  color: #fff;
  border-radius: 18rpx;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #C9CDD4;
  font-weight: 300;
}

.footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #C9CDD4;
}
