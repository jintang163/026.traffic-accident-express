/* 全局样式 */
page {
  background-color: #F5F7FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 28rpx;
  color: #1D2129;
  line-height: 1.5;
}

/* 主题变量 */
page {
  --color-primary: #1E5EFA;
  --color-primary-light: #4080FF;
  --color-success: #00B42A;
  --color-warning: #FF7D00;
  --color-danger: #F53F3F;
  --color-bg-page: #F5F7FA;
  --color-bg-card: #FFFFFF;
  --color-text-primary: #1D2129;
  --color-text-secondary: #4E5969;
  --color-text-auxiliary: #86909C;
  --color-border: #E5E6EB;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-button: 48rpx;
  --radius-round: 999rpx;
  --shadow-card: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-float: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  --shadow-popup: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

/* 容器样式 */
.container {
  min-height: 100vh;
  padding: 0 32rpx;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

/* 按钮样式 */
.btn {
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  text-align: center;
  box-sizing: border-box;
  transition: all 0.2s ease;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-primary {
  background: linear-gradient(135deg, #1E5EFA 0%, #4080FF 100%);
  color: #FFFFFF;
  border: none;
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-outline {
  background-color: #FFFFFF;
  color: #1E5EFA;
  border: 2rpx solid #1E5EFA;
}

.btn-outline:active {
  background-color: #F0F5FF;
}

.btn-secondary {
  background-color: #F2F3F5;
  color: #4E5969;
  border: none;
}

.btn-lg {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
}

.btn-sm {
  height: 64rpx;
  line-height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  display: inline-block;
  width: auto;
}

.btn-block {
  width: 100%;
}

/* 文本样式 */
.text-primary {
  color: #1D2129;
}

.text-secondary {
  color: #4E5969;
}

.text-auxiliary {
  color: #86909C;
}

.text-success {
  color: #00B42A;
}

.text-warning {
  color: #FF7D00;
}

.text-danger {
  color: #F53F3F;
}

.text-primary-color {
  color: #1E5EFA;
}

.text-xl {
  font-size: 40rpx;
  font-weight: 600;
}

.text-lg {
  font-size: 34rpx;
  font-weight: 600;
}

.text-md {
  font-size: 30rpx;
  font-weight: 500;
}

.text-sm {
  font-size: 26rpx;
}

.text-xs {
  font-size: 22rpx;
}

.text-bold {
  font-weight: 600;
}

/* 布局样式 */
.flex {
  display: flex;
}

.flex-row {
  flex-direction: row;
}

.flex-col {
  flex-direction: column;
}

.flex-center {
  justify-content: center;
  align-items: center;
}

.flex-between {
  justify-content: space-between;
  align-items: center;
}

.flex-start {
  justify-content: flex-start;
  align-items: center;
}

.flex-end {
  justify-content: flex-end;
  align-items: center;
}

.flex-1 {
  flex: 1;
}

.flex-wrap {
  flex-wrap: wrap;
}

.align-center {
  align-items: center;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

/* 间距 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mt-32 { margin-top: 32rpx; }
.mt-48 { margin-top: 48rpx; }
.mt-64 { margin-top: 64rpx; }

.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.mb-32 { margin-bottom: 32rpx; }
.mb-48 { margin-bottom: 48rpx; }

.ml-8 { margin-left: 8rpx; }
.ml-16 { margin-left: 16rpx; }
.ml-24 { margin-left: 24rpx; }

.mr-8 { margin-right: 8rpx; }
.mr-16 { margin-right: 16rpx; }
.mr-24 { margin-right: 24rpx; }

.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }
.p-32 { padding: 32rpx; }
.p-48 { padding: 48rpx; }

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-primary {
  background-color: #E8F3FF;
  color: #1E5EFA;
}

.tag-success {
  background-color: #E8FFEA;
  color: #00B42A;
}

.tag-warning {
  background-color: #FFF7E8;
  color: #FF7D00;
}

.tag-danger {
  background-color: #FFECE8;
  color: #F53F3F;
}

.tag-default {
  background-color: #F2F3F5;
  color: #86909C;
}

/* 分割线 */
.divider {
  height: 1rpx;
  background-color: #F2F3F5;
  margin: 24rpx 0;
}

/* 空状态 */
.empty {
  padding: 80rpx 0;
  text-align: center;
}

.empty-icon {
  font-size: 120rpx;
  color: #C9CDD4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #86909C;
}

/* 表单样式 */
.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #1D2129;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-label-required::before {
  content: '*';
  color: #F53F3F;
  margin-right: 8rpx;
}

.form-input {
  height: 88rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  box-sizing: border-box;
}

.form-input::placeholder {
  color: #86909C;
}

.form-textarea {
  min-height: 200rpx;
  background-color: #F7F8FA;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1D2129;
  box-sizing: border-box;
  width: 100%;
}

.form-textarea::placeholder {
  color: #86909C;
}

/* 底部操作栏 */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* 进度步骤 */
.steps {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 32rpx 0;
  position: relative;
}

.steps::before {
  content: '';
  position: absolute;
  top: 52rpx;
  left: 60rpx;
  right: 60rpx;
  height: 4rpx;
  background-color: #E5E6EB;
  z-index: 0;
}

.step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  z-index: 1;
}

.step-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  border: 4rpx solid #E5E6EB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #86909C;
  margin-bottom: 12rpx;
  transition: all 0.3s ease;
}

.step-active .step-circle {
  background: linear-gradient(135deg, #1E5EFA 0%, #4080FF 100%);
  border-color: #1E5EFA;
  color: #FFFFFF;
}

.step-completed .step-circle {
  background-color: #00B42A;
  border-color: #00B42A;
  color: #FFFFFF;
}

.step-text {
  font-size: 24rpx;
  color: #86909C;
  text-align: center;
}

.step-active .step-text,
.step-completed .step-text {
  color: #1E5EFA;
  font-weight: 500;
}

/* 加载动画 */
.loading {
  display: inline-block;
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #E5E6EB;
  border-top-color: #1E5EFA;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 单行省略 */
.ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 多行省略 */
.ellipsis-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.ellipsis-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 安全区域 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面头部间距 */
.page-header {
  padding-top: 32rpx;
  padding-bottom: 16rpx;
}
