# 服务配置
PORT=3000
BASE_URL=http://localhost:3000/api

# 生产环境示例
# BASE_URL=https://your-domain.com/api
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password
DB_DATABASE=traffic_accident

# JWT配置
JWT_SECRET=your-secret-key-here-change-in-production
JWT_EXPIRES_IN=7d

# OCR配置（百度OCR）
BAIDU_OCR_API_KEY=your-baidu-api-key
BAIDU_OCR_SECRET_KEY=your-baidu-secret-key

# OCR配置（腾讯云OCR）
TENCENT_OCR_SECRET_ID=your-tencent-secret-id
TENCENT_OCR_SECRET_KEY=your-tencent-secret-key
TENCENT_OCR_REGION=ap-beijing

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 小程序配置
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret
WX_APPID=your-wechat-app-id
WX_SECRET=your-wechat-app-secret

# 微信订阅消息模板ID
WX_TEMPLATE_LIABILITY=TMPL_LIABILITY
WX_TEMPLATE_CERTIFICATE=TMPL_CERTIFICATE
WX_TEMPLATE_APPEAL=TMPL_APPEAL
WX_TEMPLATE_EVIDENCE=TMPL_EVIDENCE

# 短信服务配置
SMS_PROVIDER=mock

# 阿里云短信配置
ALIYUN_SMS_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_SMS_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=your-sign-name

# 腾讯云短信配置
TENCENT_SMS_SECRET_ID=your-tencent-secret-id
TENCENT_SMS_SECRET_KEY=your-tencent-secret-key
TENCENT_SMS_APP_ID=your-sms-app-id
TENCENT_SMS_SIGN_NAME=your-sign-name
TENCENT_SMS_REGION=ap-guangzhou

# 短信模板ID
SMS_TEMPLATE_LIABILITY=SMS_LIABILITY
SMS_TEMPLATE_CERTIFICATE=SMS_CERTIFICATE
SMS_TEMPLATE_APPEAL=SMS_APPEAL
SMS_TEMPLATE_EVIDENCE=SMS_EVIDENCE

# 消息队列配置 (可选，默认使用内存队列)
MQ_PROVIDER=memory

# Redis配置 (可选，默认使用内存缓存)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 电子签章配置 - CFCA
ESIGN_CFCA_API_URL=https://esign.cfca.com.cn
ESIGN_CFCA_API_KEY=your-cfca-api-key
ESIGN_CFCA_API_SECRET=your-cfca-api-secret

# 电子签章配置 - 法大大
ESIGN_FADADA_API_URL=https://api.fadada.com
ESIGN_FADADA_API_KEY=your-fadada-api-key
ESIGN_FADADA_API_SECRET=your-fadada-api-secret
